{
  "expo": {
    "name": "Diralo",
    "slug": "diralo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.diralo.twa"
    },
    "android": {
      "package": "app.diralo.twa",
      "versionCode": 13,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "diralo.app",
              "path": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "09d4805b-90d1-4164-a87e-17aa42d73a5f"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Diralo braucht das Mikrofon für Sprachnachrichten und den Dolmetscher.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Diralo braucht Zugriff auf deine Fotos, damit du Bilder im Chat senden kannst.",
          "cameraPermission": "Diralo braucht die Kamera, damit du Fotos und Videos im Chat senden kannst.",
          "microphonePermission": "Diralo braucht das Mikrofon für Sprachnachrichten und den Dolmetscher."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Diralo braucht deinen Standort nur, wenn du ihn im Chat teilst."
        }
      ],
      "expo-speech-recognition",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#122036",
          "defaultChannel": "nachrichten"
        }
      ],
      "expo-iap",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "video/*",
            "application/*",
            "audio/*"
          ],
          "disableIOS": true
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class livekit.org.webrtc.** { *; }\n-keep class livekit.org.jni_zero.** { *; }\n-dontwarn livekit.org.jni_zero.**\n-dontwarn livekit.org.webrtc.**"
          }
        }
      ],
      "expo-image",
      "./plugins/hochformat-optional",
      "expo-video"
    ],
    "scheme": "diralo"
  }
}
