{
  "expo": {
    "name": "Diralo",
    "slug": "diralo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.diralo.twa"
    },
    "android": {
      "package": "app.diralo.twa",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#122036",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "09d4805b-90d1-4164-a87e-17aa42d73a5f"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Diralo braucht Zugriff auf deine Fotos, damit du Bilder im Chat senden kannst.",
          "cameraPermission": "Diralo braucht die Kamera, damit du Fotos im Chat senden kannst.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Diralo braucht deinen Standort nur, wenn du ihn im Chat teilst."
        }
      ],
      "expo-speech-recognition",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#122036",
          "defaultChannel": "nachrichten"
        }
      ],
      "expo-iap"
    ]
  }
}
