# ----------------------------------------------------------------------
# Pflicht
# ----------------------------------------------------------------------

# Anthropic API-Key. Holen auf console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...


# ----------------------------------------------------------------------
# Datenbank. Ohne sie sind Nachrichten nach jedem Neustart weg
# und Push funktioniert nicht zuverlaessig.
# Bei Render setzt sich das automatisch, wenn eine Postgres-Instanz
# mit dem Service verknuepft ist.
# ----------------------------------------------------------------------
DATABASE_URL=


# ----------------------------------------------------------------------
# Web Push. Schluessel einmalig erzeugen mit:  npm run vapid
# Der private Schluessel gehoert nur hierher, nie ins Repo.
# ----------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:deine@mailadresse.pt


# ----------------------------------------------------------------------
# Optional
# ----------------------------------------------------------------------
ANTHROPIC_MODEL=claude-sonnet-5
PORT=3000


# ----------------------------------------------------------------------
# Zugangswort. Solange etwas drinsteht, kommt niemand ohne dieses Wort
# in die App. Leer lassen heisst: die App ist oeffentlich erreichbar.
# ----------------------------------------------------------------------
ACCESS_CODE=

# ----------------------------------------------------------------------
# Aufbewahrung in Tagen. Aeltere Nachrichten werden automatisch geloescht.
# 0 bedeutet: nie loeschen (nicht empfohlen).
# ----------------------------------------------------------------------
RETENTION_DAYS=30

# ----------------------------------------------------------------------
# Bremse. Jede Uebersetzung kostet, und eine Nachricht loest eine je
# Lesersprache aus. 0 schaltet die jeweilige Grenze ab.
#
# TRANSLATIONS_PER_DAY ist die eigentliche Sicherung der Rechnung:
# Ist sie erreicht, kommen Nachrichten weiter an, werden aber im
# Original angezeigt statt uebersetzt.
# ----------------------------------------------------------------------
MSG_PER_MIN=20
NEED_PER_MIN=120
TRANSLATIONS_PER_DAY=2000
GATE_TRIES_PER_15MIN=10

# ----------------------------------------------------------------------
# Sprachnachrichten. Die Aufnahmen liegen in der Datenbank - eine halbe
# Minute Opus sind rund 40 KB. Laenger als zwei Minuten waere fuer einen
# Chat ohnehin unueblich, und die Datenbank hat nur 256 MB.
# ----------------------------------------------------------------------
VOICE_MAX_SECONDS=120
VOICE_MAX_BYTES=1500000

# ----------------------------------------------------------------------
# Preise in US-Dollar je eine Million Tokens, fuer die Kostenrechnung
# auf /stats.html. Stand September 2026 fuer Sonnet 5.
# ----------------------------------------------------------------------
PRICE_IN_PER_MTOK=2
PRICE_OUT_PER_MTOK=10
